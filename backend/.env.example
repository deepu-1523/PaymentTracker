# Port for the Express server (Default: 5000)
PORT=5000

# MongoDB Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/dueledger
# Cloud MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/dueledger?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dueledger

# Secret key for signing JWT tokens (Change this to any random secure string)
JWT_SECRET=dueledger_super_secret_jwt_key_2026

# JWT Token Expiration
JWT_EXPIRES_IN=30d

# Node Environment: development | production
NODE_ENV=development
